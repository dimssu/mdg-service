/**
 * Draws real report cards from the backend's own HTML builders, with invented
 * figures, and ships them to the page as JS (file:// cannot fetch).
 *
 * Run ONLY with dummy env, from the repo root (the backend's config loads the
 * laptop .env, which points at production):
 *
 *   env -i PATH="$PATH" HOME="$HOME" MONGODB_URI='mongodb://127.0.0.1:1/none' \
 *     JWT_SECRET='local-render-only-xxxxxxxx' NODE_ENV=test LOG_LEVEL=silent \
 *     node_modules/.bin/tsx marketing/reels/kit/cards/build-cards.mts \
 *       marketing/reels/kit/cards/fixtures/01-dsr.mjs \
 *       marketing/reels/01-dsr/build/.cards-src/src \
 *       marketing/reels/01-dsr/build/cards.js
 *
 * <src> is a clean HEAD copy (`git -C mdg-backend archive HEAD src | tar -x`),
 * never the working tree. Writes <out> (window.CARDS = {name: html}) and one
 * <name>.html beside it for reference shots.
 */
import fs from 'node:fs';
import path from 'node:path';

const [fixturePath, srcRoot, outJs] = process.argv.slice(2);
if (!fixturePath || !srcRoot || !outJs) throw new Error('usage: build-cards.mts <fixture.mjs> <cards-src/src> <out cards.js>');

const SRC = path.resolve(srcRoot);
const BUILDERS: Record<string, () => Promise<(input: any) => string>> = {
  'dsr-sales': async () => (await import(path.join(SRC, 'services/dsr-report/cards.ts'))).buildSalesCardHtml,
  'dsr-variation': async () => (await import(path.join(SRC, 'services/dsr-report/cards.ts'))).buildVariationCardHtml,
  // reel 03: the CREDIT & DOD card — the run's figures → display rows → HTML (no festival band)
  'credit-dod': async () => {
    const { buildCreditCard } = await import(path.join(SRC, 'automation/sdms/report/creditCard.ts'));
    const { cardHtml } = await import(path.join(SRC, 'automation/sdms/report/renderCard.ts'));
    return (input: any) => cardHtml(buildCreditCard(input), null);
  },
};

const { cards } = await import(path.resolve(fixturePath));
const out: Record<string, string> = {};
const outDir = path.dirname(path.resolve(outJs));
for (const c of cards) {
  const make = BUILDERS[c.builder];
  if (!make) throw new Error(`no builder "${c.builder}" — add it to BUILDERS`);
  const html = (await make())(c.input);
  out[c.name] = html;
  fs.writeFileSync(path.join(outDir, `card-${c.name}.html`), html);
  console.log(`→ ${c.name} (${c.builder}) ${html.length} chars`);
}
fs.writeFileSync(path.resolve(outJs),
  `// GENERATED by kit/cards/build-cards.mts from ${path.basename(fixturePath)} — do not edit.\nwindow.CARDS = ${JSON.stringify(out)};\n`);
console.log(`→ ${outJs}`);
